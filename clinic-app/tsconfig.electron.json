{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "electron",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "dist-electron",
        "types": [
            "node",
            "electron"
        ],
        "sourceMap": true
    },
    "include": [
        "electron/**/*.ts"
    ]
}